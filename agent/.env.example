# LLM provider: "openai" or "gemini" (default: openai)
IRW_LLM_PROVIDER=openai

# --- OpenAI (when IRW_LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Gemini (when IRW_LLM_PROVIDER=gemini) ---
GOOGLE_API_KEY=...
# or: GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash

# Optional: CORS origins (comma-separated; default * for dev)
# CORS_ORIGINS=https://itemresponsewarehouse.org,http://localhost:4200
